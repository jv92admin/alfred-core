# === Required ===

# OpenAI API key — read by alfredagain core (CoreSettings).
# App will not start without this.
OPENAI_API_KEY=sk-your-key-here

# Your domain's Supabase instance
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# === Development (recommended for getting started) ===

# Use cheap models (gpt-4.1-mini) for all nodes.
# Set to "true" for full model hierarchy (gpt-4.1 for complex tasks).
ALFRED_USE_ADVANCED_MODELS=false

# Log all LLM prompts to prompt_logs/ directory.
# Invaluable for prompt tuning — see exactly what each node receives.
# ALFRED_LOG_PROMPTS=1

# === Optional ===

# ALFRED_ENV=development          # "development" | "staging" | "production"
# LOG_LEVEL=INFO                  # "DEBUG" | "INFO" | "WARNING" | "ERROR"
# ALFRED_LOG_TO_DB=0              # "1" to log prompts to Supabase prompt_logs table
# ALFRED_LOG_KEEP_SESSIONS=4      # DB log sessions to keep before cleanup

# === Observability (LangSmith) ===

# LANGCHAIN_TRACING_V2=false      # "true" to enable LangSmith tracing
# LANGCHAIN_API_KEY=ls__...       # Required if tracing enabled
# LANGCHAIN_PROJECT=alfred-v2     # LangSmith project name
